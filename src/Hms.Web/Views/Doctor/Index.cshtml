@model Hms.Web.ViewModels.Doctor.DoctorListViewModel
@{
    ViewData["Title"] = "Doctors";
}
@section Styles { <link rel="stylesheet" href="~/css/pages/admin.css" asp-append-version="true" /> }

<div class="hms-page-header">
    <h1>Doctors</h1>
    <a class="hms-btn hms-btn-primary" asp-action="Create">New doctor</a>
</div>

<div class="hms-card">
    <form method="get" asp-action="Index" class="hms-toolbar">
        <select name="departmentId" aria-label="Department filter" onchange="this.form.submit()">
            <option value="">All departments</option>
            @foreach (var department in Model.Departments)
            {
                <option value="@department.Id" selected="@(Model.DepartmentId == department.Id)">@department.Name</option>
            }
        </select>
        <button type="submit" class="hms-btn hms-btn-secondary">Apply</button>
    </form>

    @if (Model.Rows.Count == 0)
    {
        <partial name="_EmptyState" model='"No records found."' />
    }
    else
    {
        <div class="hms-table-wrap">
            <table class="hms-table">
                <thead><tr><th>Name</th><th>Specialization</th><th>Department</th><th>Consultation fee</th><th>Status</th><th>Actions</th></tr></thead>
                <tbody>
                @foreach (var doctor in Model.Rows)
                {
                    <tr>
                        <td>@doctor.FullName</td><td>@doctor.Specialization</td><td>@doctor.DepartmentName</td>
                        <td>₹@doctor.ConsultationFee.ToString("0.00")</td>
                        <td><partial name="_StatusBadge" model="@doctor.Status" /></td>
                        <td class="hms-row-actions">
                            <a class="hms-btn hms-btn-secondary" asp-action="Details" asp-route-id="@doctor.Id">View</a>
                            <a class="hms-btn hms-btn-secondary" asp-action="Edit" asp-route-id="@doctor.Id">Edit</a>
                            @if (doctor.Status == Hms.Web.Models.Entities.EntityStatus.Active)
                            {
                                <form asp-action="Deactivate" asp-route-id="@doctor.Id" method="post" class="hms-inline-form">
                                    <button type="submit" class="hms-btn hms-btn-secondary" data-confirm>Deactivate</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
<partial name="_ConfirmDialog" model='"Deactivate this doctor? Their sign-in and new bookings will be blocked."' />
