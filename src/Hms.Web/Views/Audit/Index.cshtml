@model IReadOnlyList<Hms.Web.Models.Entities.AuditEntry>
@{
    ViewData["Title"] = "Audit trail";
    var recordTypes = new[] { "MedicalRecord", "Prescription", "Invoice", "Payment" };
}
<h1>Audit trail</h1>

<div class="hms-card">
    <form method="get" class="hms-form-grid">
        <div class="hms-field">
            <label for="recordType">Record type</label>
            <select id="recordType" name="recordType">
                <option value="">All record types</option>
                @foreach (var type in recordTypes)
                {
                    <option value="@type" selected="@(ViewData["RecordType"]?.ToString() == type)">@type</option>
                }
            </select>
        </div>
        <div class="hms-field"><label for="from">Start date</label><input id="from" name="from" type="date" /></div>
        <div class="hms-field"><label for="to">End date</label><input id="to" name="to" type="date" /></div>
        <div class="hms-form-actions"><button type="submit" class="hms-btn hms-btn-primary">Filter</button></div>
    </form>

    @if (Model.Count == 0)
    {
        <partial name="_EmptyState" model="@("No records found.")" />
    }
    else
    {
        <table class="hms-table">
            <thead><tr><th>Record type</th><th>Record ID</th><th>Field</th><th>Previous</th><th>New</th><th>User</th><th>Time</th></tr></thead>
            <tbody>
                @foreach (var entry in Model)
                {
                    <tr>
                        <td>@entry.RecordType</td>
                        <td>@entry.RecordId</td>
                        <td>@entry.FieldName</td>
                        <td>@entry.OldValue</td>
                        <td>@entry.NewValue</td>
                        <td>@entry.UserName</td>
                        <td>@entry.ChangedAt.ToString("dd MMM yyyy HH:mm")</td>
                    </tr>
                }
            </tbody>
        </table>
        <partial name="_Pagination" model="@(Convert.ToInt32(ViewData["Page"] ?? 1))" />
    }
</div>
