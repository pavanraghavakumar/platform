@model Hms.Web.ViewModels.Report.PatientReportViewModel
@{
    ViewData["Title"] = "Patient registrations report";
}
<h1>Patient registrations</h1><partial name="_DateFilter" model="Model.Period" />
<div class="hms-card report-section"><div class="report-heading"><h2>Registered patients</h2><strong>@Model.Total</strong></div>@if (Model.Patients.Count == 0) { <partial name="_EmptyState" model="@("No records found.")" /> } else { <div class="report-table-wrap"><table class="hms-table"><thead><tr><th>Patient ID</th><th>Name</th><th>Registration date</th></tr></thead><tbody>@foreach(var row in Model.Patients){<tr><td>@row.PatientCode</td><td>@row.Name</td><td>@row.RegisteredAt.ToString("dd MMM yyyy")</td></tr>}</tbody></table></div> }</div>
@section Styles { <link rel="stylesheet" href="~/css/pages/report.css" asp-append-version="true" /> }
