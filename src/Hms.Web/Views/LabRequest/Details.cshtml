@model Hms.Web.Models.Entities.LabRequest
@{
    ViewData["Title"] = "Lab request";
    var isCompleted = Model.Status == Hms.Web.Models.Entities.EntityStatus.LabCompleted;
}
@section Styles {
    <link rel="stylesheet" href="~/css/pages/lab.css" asp-append-version="true" />
}

<div class="hms-page-header">
    <h1>Lab request</h1>
    @if (isCompleted)
    {
        <a class="hms-btn hms-btn-primary" asp-controller="LabRequest" asp-action="Print" asp-route-id="@Model.Id"><i class="bi bi-printer"></i>Printable report</a>
    }
</div>

<div class="hms-card">
    <dl class="hms-lab-details">
        <dt>Patient</dt><dd>@Model.Patient?.FullName (@Model.Patient?.PatientCode)</dd>
        <dt>Test</dt><dd>@Model.LaboratoryTest?.Name</dd>
        <dt>Normal range</dt><dd>@Model.LaboratoryTest?.NormalRange</dd>
        <dt>Requesting doctor</dt><dd>@Model.Doctor?.FullName</dd>
        <dt>Requested on</dt><dd>@Model.CreatedAt.ToString("dd MMM yyyy")</dd>
        <dt>Status</dt><dd><partial name="_StatusBadge" model="@Model.Status" /></dd>
        @if (isCompleted)
        {
            <dt>Result value</dt><dd>@Model.ResultValue</dd>
            <dt>Remarks</dt><dd>@Model.Remarks</dd>
            <dt>Result entered</dt><dd>@Model.ResultEnteredAt?.ToString("dd MMM yyyy HH:mm")</dd>
        }
    </dl>
</div>
