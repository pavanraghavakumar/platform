@model Hms.Web.ViewModels.Lab.LabResultViewModel
@{
    ViewData["Title"] = "Enter lab result";
    var request = Model.Request;
}
@section Styles {
    <link rel="stylesheet" href="~/css/pages/lab.css" asp-append-version="true" />
}

<div class="hms-page-header">
    <h1>Enter lab result</h1>
</div>

<div class="hms-card">
    <dl class="hms-lab-details">
        <dt>Patient</dt><dd>@request.Patient?.FullName (@request.Patient?.PatientCode)</dd>
        <dt>Test</dt><dd>@request.LaboratoryTest?.Name</dd>
        <dt>Normal range</dt><dd>@request.LaboratoryTest?.NormalRange</dd>
        <dt>Requesting doctor</dt><dd>@request.Doctor?.FullName</dd>
    </dl>

    <form asp-controller="LabRequest" asp-action="Complete" asp-route-id="@request.Id" method="post">
        <div asp-validation-summary="ModelOnly" class="hms-alert hms-alert-error" hidden="@(ViewData.ModelState.IsValid)"></div>
        <div class="hms-form-grid">
            <div class="hms-field">
                <label asp-for="ResultValue">Result value</label>
                <input asp-for="ResultValue" />
                <span asp-validation-for="ResultValue" class="field-validation-error"></span>
            </div>
            <div class="hms-field">
                <label asp-for="Remarks">Remarks</label>
                <textarea asp-for="Remarks" rows="3"></textarea>
                <span asp-validation-for="Remarks" class="field-validation-error"></span>
            </div>
        </div>
        <div class="hms-form-actions">
            <a class="hms-btn hms-btn-secondary" asp-controller="LabRequest" asp-action="Index">Cancel</a>
            <button type="submit" class="hms-btn hms-btn-primary">Save result</button>
        </div>
    </form>
</div>
