@model Hms.Web.ViewModels.Department.DepartmentListViewModel
@{
    ViewData["Title"] = "Departments";
}
@section Styles {
    <link rel="stylesheet" href="~/css/pages/admin.css" asp-append-version="true" />
}

<div class="hms-page-header">
    <h1>Departments</h1>
    <a class="hms-btn hms-btn-primary" asp-controller="Department" asp-action="Create">New department</a>
</div>

@if (TempData["Message"] is string message)
{
    <div class="hms-alert hms-alert-success" role="status">@message</div>
}

<div class="hms-card">
    <form method="get" asp-controller="Department" asp-action="Index" class="hms-toolbar">
        <div class="hms-search-box">
            <i class="bi bi-search"></i>
            <input type="search" name="search" value="@Model.Search" placeholder="Search departments" aria-label="Search departments" />
        </div>
        <select name="sort" aria-label="Sort by" onchange="this.form.submit()">
            <option value="name" selected="@(Model.Sort == "name")">Name (A–Z)</option>
            <option value="name_desc" selected="@(Model.Sort == "name_desc")">Name (Z–A)</option>
            <option value="status" selected="@(Model.Sort == "status")">Status</option>
        </select>
        <select name="status" aria-label="Status filter" onchange="this.form.submit()">
            <option value="">All statuses</option>
            <option value="Active" selected="@(Model.Status == "Active")">Active</option>
            <option value="Inactive" selected="@(Model.Status == "Inactive")">Inactive</option>
        </select>
        <button type="submit" class="hms-btn hms-btn-secondary">Apply</button>
    </form>

    @if (Model.Rows.Count == 0)
    {
        <partial name="_EmptyState" model="@("No records found.")" />
    }
    else
    {
        <table class="hms-table">
            <thead>
                <tr><th>Name</th><th>Doctors</th><th>Staff</th><th>Status</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var department in Model.Rows)
                {
                    <tr>
                        <td>@department.Name</td>
                        <td>@department.DoctorCount</td>
                        <td>@department.StaffCount</td>
                        <td><partial name="_StatusBadge" model="@department.Status" /></td>
                        <td>
                            @if (department.Status == Hms.Web.Models.Entities.EntityStatus.Active)
                            {
                                <form asp-controller="Department" asp-action="Deactivate" asp-route-id="@department.Id" method="post" class="hms-inline-form">
                                    <button type="submit" class="hms-btn hms-btn-secondary" data-confirm>Deactivate</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="hms-list-footer">
            <span class="hms-list-count">@Model.TotalCount department(s)</span>
            <nav class="hms-pagination" aria-label="Department pagination">
                @if (Model.Page > 1)
                {
                    <a class="hms-btn hms-btn-secondary"
                       asp-controller="Department" asp-action="Index"
                       asp-route-search="@Model.Search" asp-route-sort="@Model.Sort"
                       asp-route-status="@Model.Status" asp-route-page="@(Model.Page - 1)">Previous</a>
                }
                else
                {
                    <span class="hms-btn hms-btn-secondary" aria-disabled="true">Previous</span>
                }

                <div class="hms-pagination-pages" aria-label="Pages">
                    @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
                    {
                        if (pageNumber == Model.Page)
                        {
                            <span class="hms-pagination-number is-current" aria-current="page">@pageNumber</span>
                        }
                        else
                        {
                            <a class="hms-pagination-number"
                               asp-controller="Department" asp-action="Index"
                               asp-route-search="@Model.Search" asp-route-sort="@Model.Sort"
                               asp-route-status="@Model.Status" asp-route-page="@pageNumber"
                               aria-label="Go to page @pageNumber">@pageNumber</a>
                        }
                    }
                </div>

                @if (Model.Page < Model.TotalPages)
                {
                    <a class="hms-btn hms-btn-secondary"
                       asp-controller="Department" asp-action="Index"
                       asp-route-search="@Model.Search" asp-route-sort="@Model.Sort"
                       asp-route-status="@Model.Status" asp-route-page="@(Model.Page + 1)">Next</a>
                }
                else
                {
                    <span class="hms-btn hms-btn-secondary" aria-disabled="true">Next</span>
                }
            </nav>
        </div>
    }
</div>
<partial name="_ConfirmDialog" model="@("Deactivate this department? Its doctors and appointments are kept.")" />
