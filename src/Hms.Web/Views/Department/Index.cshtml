@model IReadOnlyList<Hms.Web.Models.Entities.Department>
@{
    ViewData["Title"] = "Departments";
}
<div class="hms-page-header">
    <h1>Departments</h1>
    <a class="hms-btn hms-btn-primary" asp-controller="Department" asp-action="Create">New department</a>
</div>

<div class="hms-card">
    @if (Model.Count == 0)
    {
        <partial name="_EmptyState" model="@("No records found.")" />
    }
    else
    {
        <table class="hms-table">
            <thead>
                <tr><th>Name</th><th>Status</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var department in Model)
                {
                    <tr>
                        <td>@department.Name</td>
                        <td><partial name="_StatusBadge" model="@department.Status" /></td>
                        <td>
                            <form asp-controller="Department" asp-action="Deactivate" asp-route-id="@department.Id" method="post">
                                <button type="submit" class="hms-btn hms-btn-secondary" data-confirm>Deactivate</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
<partial name="_ConfirmDialog" model="@("Deactivate this department?")" />
