@model Hms.Web.ViewModels.Account.ForgotPasswordViewModel
@inject Hms.Web.Data.HmsDbContext Db
@{
    ViewData["Title"] = "Forgot password";

    var hospitalName = Db.SystemSettings
        .Where(s => s.Key == SystemSetting.HospitalNameKey)
        .Select(s => s.Value)
        .FirstOrDefault() ?? SystemSetting.DefaultHospitalName;
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/account.css" asp-append-version="true" />
}

<div class="hms-auth-card" id="hmsAuthCard">
    <div class="hms-auth-brand">
        <span class="hms-auth-logo" aria-hidden="true">
            <i class="bi bi-key-fill"></i>
        </span>
        <h1>@hospitalName</h1>
        <p class="hms-auth-subtitle">Forgot password</p>
    </div>

    <form asp-controller="Account" asp-action="ForgotPassword" method="post" novalidate>
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="hms-alert hms-alert-error" role="alert">
                <i class="bi bi-exclamation-circle" aria-hidden="true"></i>
                <span>@Html.Raw(string.Join("<br />", ViewData.ModelState.Values.SelectMany(v => v.Errors).Select(e => Html.Encode(e.ErrorMessage))))</span>
            </div>
        }

        <div class="hms-field">
            <label asp-for="Email">Email</label>
            <input asp-for="Email" type="email" autocomplete="email" autofocus />
        </div>

        <button type="submit" class="hms-btn hms-btn-primary hms-auth-submit">Show reset link</button>
    </form>

    @if (ViewData["ResetLink"] is string link)
    {
        <div class="hms-auth-reset" id="hmsResetLink">
            <p class="hms-auth-reset-label">Your reset link</p>
            <a href="@link" id="hmsResetLinkAnchor">@link</a>
        </div>
    }

    <p class="hms-auth-links">
        <a asp-controller="Account" asp-action="Login">Back to sign in</a>
    </p>
</div>

@section Scripts {
    <script src="~/js/pages/account.js" asp-append-version="true"></script>
}
