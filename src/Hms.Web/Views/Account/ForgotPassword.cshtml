@{
    ViewData["Title"] = "Forgot password";
}
<div class="hms-auth-card">
    <div class="hms-auth-brand">
        <i class="bi bi-key"></i>
        <h1>Forgot password</h1>
    </div>

    <form asp-controller="Account" asp-action="ForgotPassword" method="post">
        <div class="hms-field">
            <label for="email">Email</label>
            <input id="email" name="email" type="email" required />
        </div>
        <button type="submit" class="hms-btn hms-btn-primary" style="width:100%;justify-content:center;">Show reset link</button>
    </form>

    @if (ViewData["ResetLink"] is string link)
    {
        <p style="margin-top:16px;">Reset link: <a href="@link">@link</a></p>
    }

    <p style="margin-top:16px;text-align:center;">
        <a asp-controller="Account" asp-action="Login">Back to sign in</a>
    </p>
</div>
