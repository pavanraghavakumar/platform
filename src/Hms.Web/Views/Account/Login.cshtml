@model Hms.Web.ViewModels.Account.LoginViewModel
@inject Hms.Web.Data.HmsDbContext Db
@{
    ViewData["Title"] = "Sign in";

    var hospitalName = Db.SystemSettings
        .Where(s => s.Key == SystemSetting.HospitalNameKey)
        .Select(s => s.Value)
        .FirstOrDefault() ?? SystemSetting.DefaultHospitalName;
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/account.css" asp-append-version="true" />
}

<div class="hms-auth-card" id="hmsAuthCard">
    <div class="hms-auth-brand">
        <span class="hms-auth-logo" aria-hidden="true">
            <i class="bi bi-heart-pulse-fill"></i>
        </span>
        <h1>@hospitalName</h1>
        <p class="hms-auth-subtitle">Sign in to continue</p>
    </div>

    <form asp-controller="Account" asp-action="Login" method="post" novalidate>
        <input type="hidden" asp-for="ReturnUrl" />

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="hms-alert hms-alert-error" role="alert" id="hmsLoginError">
                <i class="bi bi-exclamation-circle" aria-hidden="true"></i>
                <span>@Html.Raw(string.Join("<br />", ViewData.ModelState.Values.SelectMany(v => v.Errors).Select(e => Html.Encode(e.ErrorMessage))))</span>
            </div>
        }

        <div class="hms-field">
            <label asp-for="UserName">User name</label>
            <input asp-for="UserName" type="text" autocomplete="username" autofocus />
        </div>

        <div class="hms-field">
            <label asp-for="Password">Password</label>
            <input asp-for="Password" type="password" autocomplete="current-password" />
        </div>

        <button type="submit" class="hms-btn hms-btn-primary hms-auth-submit">Sign in</button>

        <p class="hms-auth-links">
            <a asp-controller="Account" asp-action="ForgotPassword">Forgot password?</a>
        </p>
    </form>
</div>

@section Scripts {
    <script src="~/js/pages/account.js" asp-append-version="true"></script>
}
