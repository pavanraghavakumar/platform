@{
    ViewData["Title"] = "Reset password";
}
<div class="hms-auth-card">
    <div class="hms-auth-brand">
        <i class="bi bi-shield-lock"></i>
        <h1>Reset password</h1>
    </div>

    <form asp-controller="Account" asp-action="ResetPassword" method="post">
        <div asp-validation-summary="All" class="hms-alert hms-alert-error" hidden="@(ViewData.ModelState.IsValid)"></div>

        <div class="hms-field">
            <label for="email">Email</label>
            <input id="email" name="email" type="email" value="@ViewData["Email"]" required />
        </div>

        <div class="hms-field">
            <label for="password">New password</label>
            <input id="password" name="password" type="password" autocomplete="new-password" required />
        </div>

        <button type="submit" class="hms-btn hms-btn-primary" style="width:100%;justify-content:center;">Set new password</button>
    </form>
</div>
