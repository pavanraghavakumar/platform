@model Hms.Web.ViewModels.Account.ResetPasswordViewModel
@inject Hms.Web.Data.HmsDbContext Db
@{
    ViewData["Title"] = "Reset password";

    var hospitalName = Db.SystemSettings
        .Where(s => s.Key == SystemSetting.HospitalNameKey)
        .Select(s => s.Value)
        .FirstOrDefault() ?? SystemSetting.DefaultHospitalName;
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/account.css" asp-append-version="true" />
}

<div class="hms-auth-card" id="hmsAuthCard">
    <div class="hms-auth-brand">
        <span class="hms-auth-logo" aria-hidden="true">
            <i class="bi bi-shield-lock-fill"></i>
        </span>
        <h1>@hospitalName</h1>
        <p class="hms-auth-subtitle">Set a new password</p>
    </div>

    <form asp-controller="Account" asp-action="ResetPassword" method="post" novalidate>
        <input type="hidden" asp-for="Token" />

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="hms-alert hms-alert-error" role="alert">
                <i class="bi bi-exclamation-circle" aria-hidden="true"></i>
                <span>@Html.Raw(string.Join("<br />", ViewData.ModelState.Values.SelectMany(v => v.Errors).Select(e => Html.Encode(e.ErrorMessage))))</span>
            </div>
        }

        <div class="hms-field">
            <label asp-for="Email">Email</label>
            <input asp-for="Email" type="email" autocomplete="email" />
        </div>

        <div class="hms-field">
            <label asp-for="Password">New password</label>
            <input asp-for="Password" type="password" autocomplete="new-password" />
        </div>

        <div class="hms-field">
            <label asp-for="ConfirmPassword">Confirm new password</label>
            <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" />
        </div>

        <button type="submit" class="hms-btn hms-btn-primary hms-auth-submit">Set new password</button>
    </form>

    <p class="hms-auth-links">
        <a asp-controller="Account" asp-action="Login">Back to sign in</a>
    </p>
</div>

@section Scripts {
    <script src="~/js/pages/account.js" asp-append-version="true"></script>
}
