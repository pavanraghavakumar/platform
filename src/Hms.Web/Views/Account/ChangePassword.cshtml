@model Hms.Web.ViewModels.Account.ChangePasswordViewModel
@{
    ViewData["Title"] = "Change password";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/account.css" asp-append-version="true" />
}

<div class="hms-account-page hms-password-page">
    <header class="hms-account-header">
        <div class="hms-account-icon" aria-hidden="true"><i class="bi bi-shield-lock"></i></div>
        <div>
            <h1>Change password</h1>
            <p>Use your current password to protect your account with a new one.</p>
        </div>
    </header>

    <section class="hms-card hms-account-form-card">
        @if (ViewData["Message"] is string message)
        {
            <div class="hms-alert hms-alert-success" role="status">@message</div>
        }

        <form asp-controller="Account" asp-action="ChangePassword" method="post" novalidate>
            <div class="hms-field">
                <label asp-for="CurrentPassword"></label>
                <input asp-for="CurrentPassword" type="password" value="@Model.CurrentPassword" autocomplete="current-password" />
                <span asp-validation-for="CurrentPassword" class="hms-field-error"></span>
            </div>
            <div class="hms-field">
                <label asp-for="NewPassword"></label>
                <input asp-for="NewPassword" type="password" value="@Model.NewPassword" autocomplete="new-password" />
                <span asp-validation-for="NewPassword" class="hms-field-error"></span>
                <small class="hms-account-help">Use at least 8 characters.</small>
            </div>
            <div class="hms-form-actions">
                <a class="hms-btn hms-btn-secondary" asp-controller="Account" asp-action="Profile">Back to profile</a>
                <button type="submit" class="hms-btn hms-btn-primary">Change password</button>
            </div>
        </form>
    </section>
</div>
