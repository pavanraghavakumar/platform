@model Hms.Web.ViewModels.Appointment.BookAppointmentViewModel
@{
    ViewData["Title"] = "Book appointment";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/appointment.css" asp-append-version="true" />
}

<div class="hms-page-header">
    <h1>Book appointment</h1>
</div>

<div class="hms-card">
    <form asp-controller="Appointment" asp-action="Book" method="post" id="appointmentBookForm">
        <div asp-validation-summary="All" class="hms-alert hms-alert-error" hidden="@(ViewData.ModelState.IsValid)"></div>

        <div class="hms-form-grid">
            @if (Model.CanChoosePatient)
            {
                <div class="hms-field">
                    <label for="patientId">Patient</label>
                    <select id="patientId" name="PatientId">
                        <option value="">Choose a patient</option>
                        @foreach (var patient in Model.Patients)
                        {
                            <option value="@patient.Id" selected="@(Model.PatientId == patient.Id)">@patient.PatientCode - @patient.FullName</option>
                        }
                    </select>
                </div>
            }
            else
            {
                <div class="hms-field">
                    <label>Patient</label>
                    <input type="text" value="@(Model.OwnPatient is null ? "Your patient record was not found." : $"{Model.OwnPatient.PatientCode} - {Model.OwnPatient.FullName}")" readonly />
                    <input type="hidden" name="PatientId" value="@(Model.OwnPatient?.Id)" />
                </div>
            }

            <div class="hms-field">
                <label for="doctorId">Doctor</label>
                <select id="doctorId" name="DoctorId">
                    <option value="">Choose a doctor</option>
                    @foreach (var doctor in Model.Doctors)
                    {
                        <option value="@doctor.Id" selected="@(Model.DoctorId == doctor.Id)">@doctor.FullName - @doctor.Specialization</option>
                    }
                </select>
            </div>

            <div class="hms-field">
                <label for="date">Date</label>
                <input id="date" name="Date" type="date" value="@(Model.Date?.ToString("yyyy-MM-dd"))" />
            </div>

            <div class="hms-field">
                <label for="time">Time slot</label>
                <select id="time" name="Time" data-selected="@Model.Time">
                    <option value="">Choose a doctor and a date first</option>
                </select>
            </div>

            <div class="hms-field">
                <label for="notes">Notes</label>
                <input id="notes" name="Notes" type="text" value="@Model.Notes" />
            </div>
        </div>

        <div class="hms-form-actions">
            <a class="hms-btn hms-btn-secondary" asp-controller="Appointment" asp-action="Index">Cancel</a>
            <button type="submit" class="hms-btn hms-btn-primary">Book</button>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/pages/appointment.js" asp-append-version="true"></script>
}
