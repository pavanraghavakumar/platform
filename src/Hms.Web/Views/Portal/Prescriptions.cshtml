@model IReadOnlyList<Hms.Web.ViewModels.Dashboard.PatientPrescriptionRow>
@{ ViewData["Title"] = "My prescriptions"; }
@section Styles { <link rel="stylesheet" href="~/css/pages/portal.css" asp-append-version="true" /> }
<div class="hms-page-header"><h1>My prescriptions</h1></div><div class="hms-card portal-table-card">
@if (Model.Count == 0) { <partial name="_EmptyState" /> } else {
<table class="hms-table"><thead><tr><th>Date</th><th>Doctor</th><th>Medicines</th><th>Status</th><th></th></tr></thead><tbody>
@foreach (var item in Model) { <tr><td data-label="Date">@item.Date.ToString("dd MMM yyyy")</td><td data-label="Doctor">@item.DoctorName</td><td data-label="Medicines">@item.MedicineCount</td><td data-label="Status"><partial name="_StatusBadge" model="@item.Status" /></td><td><a class="hms-btn hms-btn-secondary" asp-controller="Prescription" asp-action="Print" asp-route-id="@item.Id">Open printable prescription</a></td></tr> }
</tbody></table> }</div>

