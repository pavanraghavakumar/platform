@model IReadOnlyList<Hms.Web.ViewModels.Dashboard.PatientAppointmentRow>
@{ ViewData["Title"] = "My appointments"; }
@section Styles { <link rel="stylesheet" href="~/css/pages/portal.css" asp-append-version="true" /> }
<div class="hms-page-header"><h1>My appointments</h1><a class="hms-btn hms-btn-primary" asp-action="PortalBook">Book appointment</a></div>
<div class="hms-card portal-table-card">
@if (Model.Count == 0) { <partial name="_EmptyState" /> }
else {
<table class="hms-table"><thead><tr><th>Doctor</th><th>Date</th><th>Time</th><th>Status</th><th>Action</th></tr></thead><tbody>
@foreach (var item in Model) {
<tr><td data-label="Doctor">@item.DoctorName</td><td data-label="Date">@item.AppointmentDate.ToString("dd MMM yyyy")</td><td data-label="Time">@item.StartTime.ToString(@"hh\:mm")</td><td data-label="Status"><partial name="_StatusBadge" model="@item.Status" /></td><td data-label="Action">
@if (item.Status == EntityStatus.AppointmentPending || item.Status == EntityStatus.AppointmentConfirmed) {
<form asp-action="PortalCancel" asp-route-id="@item.Id" method="post"><button class="hms-btn hms-btn-danger" type="submit" data-confirm="Cancel this appointment?">Cancel</button></form>
} else { <span>—</span> }
</td></tr> }
</tbody></table> }
</div>
<partial name="_ConfirmDialog" model="@("Cancel this appointment?")" />

