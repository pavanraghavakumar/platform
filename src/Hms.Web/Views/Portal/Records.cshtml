@model IReadOnlyList<Hms.Web.ViewModels.Dashboard.PatientRecordRow>
@{ ViewData["Title"] = "My records"; }
@section Styles { <link rel="stylesheet" href="~/css/pages/portal.css" asp-append-version="true" /> }
<div class="hms-page-header"><h1>My records</h1></div><div class="hms-card portal-table-card">
@if (Model.Count == 0) { <partial name="_EmptyState" /> } else {
<table class="hms-table"><thead><tr><th>Date</th><th>Doctor</th><th>Diagnosis</th><th></th></tr></thead><tbody>
@foreach (var item in Model) { <tr><td data-label="Date">@item.Date.ToString("dd MMM yyyy")</td><td data-label="Doctor">@item.DoctorName</td><td data-label="Diagnosis">@item.Diagnosis</td><td><a class="hms-btn hms-btn-secondary" asp-controller="MedicalRecord" asp-action="Details" asp-route-id="@item.Id">Open record</a></td></tr> }
</tbody></table> }</div>

