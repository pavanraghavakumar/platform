@model IReadOnlyList<Hms.Web.ViewModels.Dashboard.PatientLabReportRow>
@{ ViewData["Title"] = "My lab reports"; }
@section Styles { <link rel="stylesheet" href="~/css/pages/portal.css" asp-append-version="true" /> }
<div class="hms-page-header"><h1>My lab reports</h1></div><div class="hms-card portal-table-card">
@if (Model.Count == 0) { <partial name="_EmptyState" /> } else {
<table class="hms-table"><thead><tr><th>Date</th><th>Test</th><th>Doctor</th><th></th></tr></thead><tbody>
@foreach (var item in Model) { <tr><td data-label="Date">@item.Date.ToString("dd MMM yyyy")</td><td data-label="Test">@item.TestName</td><td data-label="Doctor">@item.DoctorName</td><td><a class="hms-btn hms-btn-secondary" asp-controller="LabRequest" asp-action="Print" asp-route-id="@item.Id">Open printable report</a></td></tr> }
</tbody></table> }</div>

