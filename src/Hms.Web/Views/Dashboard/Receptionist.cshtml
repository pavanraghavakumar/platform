@{
    ViewData["Title"] = "Receptionist dashboard";
}
<div class="hms-page-header">
    <h1>Receptionist dashboard</h1>
</div>

<div class="hms-kpi-grid">
    <partial name="_KpiCard" model="@(new KpiCardModel("bi-calendar-check", "—", "Appointments today"))" />
    <partial name="_KpiCard" model="@(new KpiCardModel("bi-hourglass-split", "—", "Pending appointments"))" />
    <partial name="_KpiCard" model="@(new KpiCardModel("bi-person-check", "—", "Checked in"))" />
    <partial name="_KpiCard" model="@(new KpiCardModel("bi-cash-coin", "—", "Payments today"))" />
</div>

<div class="hms-card">
    <h2>Welcome</h2>
    <p class="hms-empty">The dashboard figures are filled in by the Receptionist dashboard task.</p>
</div>
