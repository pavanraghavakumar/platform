@model Hms.Web.ViewModels.MedicalRecord.MedicalRecordDetailsViewModel
@{
    ViewData["Title"] = "Medical record";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/clinical.css" asp-append-version="true" />
}

<div class="hms-page-header">
    <div>
        <h1>Medical record</h1>
        <p class="hms-empty">@Model.PatientName (@Model.PatientCode) · @Model.Date.ToString("dd MMM yyyy")</p>
    </div>
    <a class="hms-btn hms-btn-secondary" asp-controller="MedicalRecord" asp-action="Index" asp-route-patientId="@Model.PatientId">
        <i class="bi bi-arrow-left"></i> All records
    </a>
</div>

<div class="hms-card">
    <dl class="clinical-details">
        <dt>Doctor</dt><dd>@Model.DoctorName</dd>
        <dt>Date</dt><dd>@Model.Date.ToString("dd MMM yyyy")</dd>
        <dt>Status</dt><dd><partial name="_StatusBadge" model="@Model.Status" /></dd>
        <dt>Symptoms</dt><dd>@Model.Symptoms</dd>
        <dt>Diagnosis</dt><dd>@Model.Diagnosis</dd>
        <dt>Blood pressure</dt><dd>@Model.BloodPressure</dd>
        <dt>Temperature</dt><dd>@Model.Temperature</dd>
        <dt>Pulse</dt><dd>@Model.Pulse</dd>
        <dt>Weight</dt><dd>@Model.Weight</dd>
        <dt>Treatment plan</dt><dd>@Model.TreatmentPlan</dd>
        <dt>Observations</dt><dd>@Model.Observations</dd>
        <dt>Follow-up</dt><dd>@Model.FollowUpRecommendations</dd>
    </dl>
</div>
