@model Hms.Web.Models.Entities.MedicalRecord
@{
    ViewData["Title"] = "Medical record";
}
<h1>Medical record</h1>

<div class="hms-card">
    <dl class="hms-table">
        <tr><th>Patient</th><td>@Model.Patient?.FullName (@Model.Patient?.PatientCode)</td></tr>
        <tr><th>Doctor</th><td>@Model.Doctor?.FullName</td></tr>
        <tr><th>Date</th><td>@Model.CreatedAt.ToString("dd MMM yyyy")</td></tr>
        <tr><th>Symptoms</th><td>@Model.Symptoms</td></tr>
        <tr><th>Diagnosis</th><td>@Model.Diagnosis</td></tr>
        <tr><th>Blood pressure</th><td>@Model.BloodPressure</td></tr>
        <tr><th>Temperature</th><td>@Model.Temperature</td></tr>
        <tr><th>Pulse</th><td>@Model.Pulse</td></tr>
        <tr><th>Weight</th><td>@Model.Weight</td></tr>
        <tr><th>Treatment plan</th><td>@Model.TreatmentPlan</td></tr>
        <tr><th>Observations</th><td>@Model.Observations</td></tr>
        <tr><th>Follow-up</th><td>@Model.FollowUpRecommendations</td></tr>
        <tr><th>Status</th><td><partial name="_StatusBadge" model="@Model.Status" /></td></tr>
    </dl>
</div>
