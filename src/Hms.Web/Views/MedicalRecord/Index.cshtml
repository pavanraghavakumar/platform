@model Hms.Web.ViewModels.MedicalRecord.MedicalRecordListViewModel
@{
    ViewData["Title"] = "Medical records";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/clinical.css" asp-append-version="true" />
}

<div class="hms-page-header">
    <div>
        <h1>Medical records</h1>
        <p class="hms-empty">@Model.PatientName (@Model.PatientCode)</p>
    </div>
</div>

<div class="hms-card">
    @if (Model.Records.Count == 0)
    {
        <partial name="_EmptyState" model="@("No records found.")" />
    }
    else
    {
        <table class="hms-table">
            <thead>
                <tr><th>Date</th><th>Doctor</th><th>Diagnosis</th><th>Status</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var record in Model.Records)
                {
                    <tr>
                        <td>@record.Date.ToString("dd MMM yyyy")</td>
                        <td>@record.DoctorName</td>
                        <td>@record.Diagnosis</td>
                        <td><partial name="_StatusBadge" model="@record.Status" /></td>
                        <td>
                            <a class="hms-btn hms-btn-secondary" asp-controller="MedicalRecord" asp-action="Details" asp-route-id="@record.Id">Open</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
