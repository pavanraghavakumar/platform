@model IReadOnlyList<Hms.Web.Models.Entities.MedicalRecord>
@{
    ViewData["Title"] = "Medical records";
}
<h1>Medical records</h1>

<div class="hms-card">
    @if (Model.Count == 0)
    {
        <partial name="_EmptyState" model="@("No records found.")" />
    }
    else
    {
        <table class="hms-table">
            <thead><tr><th>Date</th><th>Doctor</th><th>Diagnosis</th><th>Status</th><th></th></tr></thead>
            <tbody>
                @foreach (var record in Model)
                {
                    <tr>
                        <td>@record.CreatedAt.ToString("dd MMM yyyy")</td>
                        <td>@record.Doctor?.FullName</td>
                        <td>@record.Diagnosis</td>
                        <td><partial name="_StatusBadge" model="@record.Status" /></td>
                        <td><a class="hms-btn hms-btn-secondary" asp-controller="MedicalRecord" asp-action="Details" asp-route-id="@record.Id">Open</a></td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
