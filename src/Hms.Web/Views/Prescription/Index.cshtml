@model IReadOnlyList<Hms.Web.Models.Entities.Prescription>
@{
    ViewData["Title"] = "Prescriptions";
}
<h1>Prescriptions</h1>

<div class="hms-card">
    @if (Model.Count == 0)
    {
        <partial name="_EmptyState" model="@("No records found.")" />
    }
    else
    {
        <table class="hms-table">
            <thead><tr><th>Date</th><th>Doctor</th><th>Medicines</th><th>Status</th><th></th></tr></thead>
            <tbody>
                @foreach (var prescription in Model)
                {
                    <tr>
                        <td>@prescription.CreatedAt.ToString("dd MMM yyyy")</td>
                        <td>@prescription.Doctor?.FullName</td>
                        <td>@prescription.Items.Count</td>
                        <td><partial name="_StatusBadge" model="@prescription.Status" /></td>
                        <td><a class="hms-btn hms-btn-secondary" asp-controller="Prescription" asp-action="Print" asp-route-id="@prescription.Id">Open</a></td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
