@model Hms.Web.ViewModels.Prescription.PrescriptionHistoryViewModel
@{
    ViewData["Title"] = "Prescriptions";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/clinical.css" asp-append-version="true" />
}

<div class="hms-page-header">
    <div>
        <h1>Prescription history</h1>
        <p class="hms-page-subtitle">@Model.PatientName · @Model.PatientCode</p>
    </div>
</div>

<div class="hms-card">
    @if (Model.Prescriptions.Count == 0)
    {
        <partial name="_EmptyState" model="@("No records found.")" />
    }
    else
    {
        <div class="hms-table-wrap">
            <table class="hms-table">
                <thead><tr><th>Date</th><th>Doctor</th><th>Medicines</th><th>Status</th><th><span class="visually-hidden">Actions</span></th></tr></thead>
                <tbody>
                    @foreach (var prescription in Model.Prescriptions)
                    {
                        <tr>
                            <td>@prescription.Date.ToString("dd MMM yyyy")</td>
                            <td>@prescription.DoctorName</td>
                            <td>@prescription.MedicineCount</td>
                            <td><partial name="_StatusBadge" model="@prescription.Status" /></td>
                            <td><a class="hms-btn hms-btn-secondary" asp-action="Print" asp-route-id="@prescription.Id">Open</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
