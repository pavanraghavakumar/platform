@model Hms.Web.ViewModels.Pharmacy.MedicineCreateViewModel
@{
    ViewData["Title"] = "New medicine";
    var categories = ViewData["Categories"] as IReadOnlyList<MedicineCategory> ?? new List<MedicineCategory>();
    var suppliers = ViewData["Suppliers"] as IReadOnlyList<Supplier> ?? new List<Supplier>();
}
@section Styles {
    <link rel="stylesheet" href="~/css/pages/pharmacy.css" asp-append-version="true" />
}

<div class="hms-page-header">
    <h1>New medicine</h1>
</div>

<div class="hms-card">
    <form asp-controller="Medicine" asp-action="Create" method="post">
        <div asp-validation-summary="All" class="hms-alert hms-alert-error" hidden="@(ViewData.ModelState.IsValid)"></div>
        <div class="hms-form-grid">
            <div class="hms-field">
                <label asp-for="Name">Name</label>
                <input asp-for="Name" />
                <span asp-validation-for="Name" class="field-validation-error"></span>
            </div>
            <div class="hms-field">
                <label asp-for="CategoryId">Category</label>
                <select asp-for="CategoryId">
                    <option value="">— None —</option>
                    @foreach (var category in categories)
                    {
                        <option value="@category.Id">@category.Name</option>
                    }
                </select>
            </div>
            <div class="hms-field">
                <label asp-for="SupplierId">Supplier</label>
                <select asp-for="SupplierId">
                    <option value="">— None —</option>
                    @foreach (var supplier in suppliers)
                    {
                        <option value="@supplier.Id">@supplier.Name</option>
                    }
                </select>
            </div>
            <div class="hms-field">
                <label asp-for="UnitPrice">Unit price</label>
                <input asp-for="UnitPrice" type="number" step="0.01" min="0" />
            </div>
            <div class="hms-field">
                <label asp-for="ReorderLevel">Reorder level</label>
                <input asp-for="ReorderLevel" type="number" min="0" />
            </div>
            <div class="hms-field">
                <label asp-for="StockQuantity">Stock quantity</label>
                <input asp-for="StockQuantity" type="number" min="0" />
            </div>
        </div>
        <div class="hms-form-actions">
            <a class="hms-btn hms-btn-secondary" asp-controller="Medicine" asp-action="Index">Cancel</a>
            <button type="submit" class="hms-btn hms-btn-primary">Save</button>
        </div>
    </form>
</div>
