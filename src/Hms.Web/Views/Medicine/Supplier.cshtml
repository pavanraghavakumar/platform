@model IReadOnlyList<Hms.Web.Models.Entities.Supplier>
@{
    ViewData["Title"] = "Suppliers";
}
<h1>Suppliers</h1>

<div class="hms-card">
    <form asp-controller="Medicine" asp-action="Supplier" method="post" class="hms-form-grid">
        <div class="hms-field"><label for="name">Name</label><input id="name" name="name" /></div>
        <div class="hms-field"><label for="phone">Phone</label><input id="phone" name="phone" /></div>
        <div class="hms-field"><label for="email">Email</label><input id="email" name="email" type="email" /></div>
        <div class="hms-form-actions"><button type="submit" class="hms-btn hms-btn-primary">Add supplier</button></div>
    </form>

    @if (Model.Count == 0)
    {
        <partial name="_EmptyState" model="@("No records found.")" />
    }
    else
    {
        <table class="hms-table">
            <thead><tr><th>Name</th><th>Phone</th><th>Email</th></tr></thead>
            <tbody>
                @foreach (var supplier in Model)
                {
                    <tr><td>@supplier.Name</td><td>@supplier.Phone</td><td>@supplier.Email</td></tr>
                }
            </tbody>
        </table>
    }
</div>
