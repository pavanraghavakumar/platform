@model IReadOnlyList<Hms.Web.Models.Entities.MedicineCategory>
@{
    ViewData["Title"] = "Medicine categories";
}
<h1>Medicine categories</h1>

<div class="hms-card">
    <form asp-controller="Medicine" asp-action="Category" method="post" class="hms-form-grid">
        <div class="hms-field"><label for="name">Name</label><input id="name" name="name" /></div>
        <div class="hms-form-actions"><button type="submit" class="hms-btn hms-btn-primary">Add category</button></div>
    </form>

    @if (Model.Count == 0)
    {
        <partial name="_EmptyState" model="@("No records found.")" />
    }
    else
    {
        <table class="hms-table">
            <thead><tr><th>Name</th></tr></thead>
            <tbody>
                @foreach (var category in Model)
                {
                    <tr><td>@category.Name</td></tr>
                }
            </tbody>
        </table>
    }
</div>
