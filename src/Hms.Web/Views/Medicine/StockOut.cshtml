@model Hms.Web.Models.Entities.Medicine
@{
    ViewData["Title"] = "Stock out";
}
<h1>Stock out — @Model.Name</h1>

<div class="hms-card">
    <form asp-controller="Medicine" asp-action="StockOut" asp-route-id="@Model.Id" method="post">
        <div asp-validation-summary="All" class="hms-alert hms-alert-error" hidden="@(ViewData.ModelState.IsValid)"></div>
        <div class="hms-form-grid">
            <div class="hms-field"><label for="quantity">Quantity</label><input id="quantity" name="quantity" type="number" /></div>
            <div class="hms-field"><label for="reason">Reason</label><input id="reason" name="reason" /></div>
        </div>
        <div class="hms-form-actions">
            <a class="hms-btn hms-btn-secondary" asp-controller="Medicine" asp-action="Index">Cancel</a>
            <button type="submit" class="hms-btn hms-btn-primary">Save</button>
        </div>
    </form>
</div>
