@model Hms.Web.Models.Entities.LaboratoryTest
@{
    ViewData["Title"] = "New laboratory test";
}
<h1>New laboratory test</h1>

<div class="hms-card">
    <form asp-controller="LabTest" asp-action="Create" method="post">
        <div asp-validation-summary="All" class="hms-alert hms-alert-error" hidden="@(ViewData.ModelState.IsValid)"></div>
        <div class="hms-form-grid">
            <div class="hms-field"><label asp-for="Name">Name</label><input asp-for="Name" /></div>
            <div class="hms-field"><label asp-for="Category">Category</label><input asp-for="Category" /></div>
            <div class="hms-field"><label asp-for="Price">Price</label><input asp-for="Price" type="number" step="0.01" /></div>
            <div class="hms-field"><label asp-for="NormalRange">Normal range</label><input asp-for="NormalRange" /></div>
        </div>
        <div class="hms-form-actions">
            <a class="hms-btn hms-btn-secondary" asp-controller="LabTest" asp-action="Index">Cancel</a>
            <button type="submit" class="hms-btn hms-btn-primary">Save</button>
        </div>
    </form>
</div>
