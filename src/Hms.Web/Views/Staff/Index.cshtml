@model IReadOnlyList<Hms.Web.Models.Entities.Staff>
@{
    ViewData["Title"] = "Staff";
}
<div class="hms-page-header">
    <h1>Staff</h1>
    <a class="hms-btn hms-btn-primary" asp-controller="Staff" asp-action="Create">New staff member</a>
</div>

<div class="hms-card">
    @if (Model.Count == 0)
    {
        <partial name="_EmptyState" model="@("No records found.")" />
    }
    else
    {
        <table class="hms-table">
            <thead>
                <tr><th>Name</th><th>Role</th><th>Designation</th><th>Department</th><th>Status</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var staff in Model)
                {
                    <tr>
                        <td>@staff.FullName</td>
                        <td>@staff.Role</td>
                        <td>@staff.Designation</td>
                        <td>@staff.Department?.Name</td>
                        <td><partial name="_StatusBadge" model="@staff.Status" /></td>
                        <td>
                            <form asp-controller="Staff" asp-action="Deactivate" asp-route-id="@staff.Id" method="post">
                                <button type="submit" class="hms-btn hms-btn-secondary" data-confirm>Deactivate</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
<partial name="_ConfirmDialog" model="@("Deactivate this staff member?")" />
