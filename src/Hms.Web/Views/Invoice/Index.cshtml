@model IReadOnlyList<Hms.Web.Models.Entities.Invoice>
@{
    ViewData["Title"] = "Invoices";
    var statuses = new[] { "Unpaid", "Partially Paid", "Paid", "Cancelled" };
}
<h1>Invoices</h1>

<div class="hms-card">
    <form method="get" class="hms-search-box" style="max-width:260px;margin-bottom:16px;">
        <select name="status" onchange="this.form.submit()">
            <option value="">All statuses</option>
            @foreach (var status in statuses)
            {
                <option value="@status" selected="@(ViewData["Status"]?.ToString() == status)">@status</option>
            }
        </select>
    </form>

    @if (Model.Count == 0)
    {
        <partial name="_EmptyState" model="@("No records found.")" />
    }
    else
    {
        <table class="hms-table">
            <thead><tr><th>Invoice</th><th>Patient</th><th>Total</th><th>Paid</th><th>Status</th><th></th></tr></thead>
            <tbody>
                @foreach (var invoice in Model)
                {
                    <tr>
                        <td>@invoice.InvoiceNumber</td>
                        <td>@invoice.Patient?.FullName</td>
                        <td>₹@invoice.Total.ToString("0.00")</td>
                        <td>₹@invoice.PaidAmount.ToString("0.00")</td>
                        <td><partial name="_StatusBadge" model="@invoice.Status" /></td>
                        <td><a class="hms-btn hms-btn-secondary" asp-controller="Invoice" asp-action="Details" asp-route-id="@invoice.Id">View</a></td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
