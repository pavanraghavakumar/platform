@model Hms.Web.Models.Entities.Invoice
@{
    ViewData["Title"] = "Invoice";
}
<h1>Invoice @Model.InvoiceNumber</h1>

<div class="hms-card">
    <dl class="hms-table">
        <tr><th>Patient</th><td>@Model.Patient?.FullName (@Model.Patient?.PatientCode)</td></tr>
        <tr><th>Status</th><td><partial name="_StatusBadge" model="@Model.Status" /></td></tr>
        <tr><th>Discount</th><td>₹@Model.DiscountAmount.ToString("0.00")</td></tr>
        <tr><th>Tax rate</th><td>@Model.TaxRate.ToString("0.00")%</td></tr>
        <tr><th>Total</th><td>₹@Model.Total.ToString("0.00")</td></tr>
        <tr><th>Paid</th><td>₹@Model.PaidAmount.ToString("0.00")</td></tr>
        <tr><th>Outstanding</th><td>₹@((Model.Total - Model.PaidAmount).ToString("0.00"))</td></tr>
    </dl>

    <table class="hms-table">
        <thead><tr><th>Description</th><th>Amount</th></tr></thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr><td>@item.Description</td><td>₹@item.Amount.ToString("0.00")</td></tr>
            }
        </tbody>
    </table>
</div>

@if (User.IsInRole(Roles.Receptionist))
{
    <div class="hms-card">
        <h2>Record a payment</h2>
        <form asp-controller="Invoice" asp-action="Pay" asp-route-id="@Model.Id" method="post">
            <div class="hms-form-grid">
                <div class="hms-field"><label for="amount">Amount</label><input id="amount" name="amount" type="number" step="0.01" /></div>
                <div class="hms-field">
                    <label for="method">Method</label>
                    <select id="method" name="method">
                        <option value="Cash">Cash</option>
                        <option value="Card">Card</option>
                        <option value="UPI">UPI</option>
                        <option value="Bank Transfer">Bank Transfer</option>
                    </select>
                </div>
                <div class="hms-field"><label for="paidAt">Date</label><input id="paidAt" name="paidAt" type="date" /></div>
            </div>
            <div class="hms-form-actions">
                <button type="submit" class="hms-btn hms-btn-primary">Record payment</button>
            </div>
        </form>
    </div>
}
