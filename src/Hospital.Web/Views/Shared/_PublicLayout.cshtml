<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <title>@ViewData["Title"] - Meridian Hospital</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <header class="public-header" role="banner">
        <div class="shell public-header__inner">
            <a class="wordmark" href="/" aria-label="Meridian Hospital home">Meridian Hospital</a>
            <a class="button button--primary" href="/appointments/book">Book an Appointment</a>
        </div>
    </header>
    <main id="main-content" tabindex="-1">
        @RenderBody()
    </main>
    <footer class="public-footer">
        <div class="shell">
            <p><strong>Meridian Hospital</strong></p>
            <p><a href="/emergency-care">Emergency Care</a></p>
        </div>
    </footer>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
