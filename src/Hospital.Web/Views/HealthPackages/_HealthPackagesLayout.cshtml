<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <title>@ViewData["Title"] - Meridian Hospital</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/health-packages.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <header class="public-header" role="banner">
        <div class="shell public-header__inner health-packages-header">
            <a class="wordmark" href="/" aria-label="Meridian Hospital home">Meridian Hospital</a>
            <nav aria-label="Health packages navigation">
                <a class="health-packages-header__link" href="/health-packages" aria-current="page">Health Packages</a>
            </nav>
        </div>
    </header>
    <main id="main-content" tabindex="-1">
        @RenderBody()
    </main>
    <footer class="public-footer">
        <div class="shell health-packages-footer">
            <div>
                <p><strong>Meridian Hospital</strong></p>
                <p>Clear health information to help you prepare for a conversation with your care team.</p>
            </div>
            <p><a href="/emergency-care">Emergency Care</a></p>
        </div>
    </footer>
</body>
</html>
