@{
    ViewData["Title"] = "Health Package Not Found";
}

<section class="shell health-package-not-found" aria-labelledby="not-found-title">
    <div class="health-package-not-found__mark" aria-hidden="true">404</div>
    <p class="health-packages-eyebrow">Package unavailable</p>
    <h1 id="not-found-title">We couldn't find that health package</h1>
    <p>The package may be unpublished, withdrawn, archived, or no longer available. Explore our current health package information instead.</p>
    <a class="health-package-back-link health-package-back-link--prominent" href="/health-packages">
        <span aria-hidden="true">←</span> Return to Health Packages
    </a>
</section>
